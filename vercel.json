{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ],
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "https://gateway.pivota.cc/v1/:path*"
    },
    {
      "source": "/v2/:path*",
      "destination": "https://gateway.pivota.cc/v2/:path*"
    },
    {
      "source": "/health",
      "destination": "https://gateway.pivota.cc/health"
    },
    {
      "source": "/healthz",
      "destination": "https://gateway.pivota.cc/healthz"
    },
    {
      "source": "/metrics",
      "destination": "https://gateway.pivota.cc/metrics"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
